# ==============================================================================
# Nova Idiomas Colombia - Asistente Inteligente RAG y Automatización
# ==============================================================================

# Configuración del Servidor y Aplicación
APP_NAME="Nova Idiomas - Asistente Inteligente de Atención y Admisiones"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Base de Datos Vectorial y Recuperación Híbrida
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=idiomas_knowledge_base
SIMILARITY_THRESHOLD=0.50
TOP_K_RESULTS=3

# Proveedores de LLM e Inteligencia Artificial
# Opciones soportadas: "openrouter", "openai", "opencode", o "mock" (100% offline grounded)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=nousresearch/hermes-3-llama-3.1-8b
LLM_TEMPERATURE=0.2

# OpenCode Reasoning Daemon (Local)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_ENABLED=True

# Escalamiento a Asesores Humanos y Notificaciones
ADMISSIONS_OFFICE_EMAIL=admisiones@novaidiomas.edu.co
SUPPORT_OFFICE_EMAIL=soporte@novaidiomas.edu.co
ESCALATIONS_LOG_PATH=./data/escalations.json
ESCALATION_WEBHOOK_URL=

# Integración con Bot de Telegram en Python
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=False

# Caché de Respuestas Frecuentes
CACHE_TTL_SECONDS=3600

