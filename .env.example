# ==============================================================================
# Nova Tech University - Admissions RAG Assistant Configuration (v2.0.0)
# ==============================================================================

# Application Settings
APP_NAME="Nova Tech University Admissions RAG Assistant"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Vector Database & Free Local Embeddings
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=admissions_knowledge_base
SIMILARITY_THRESHOLD=0.65
TOP_K_RESULTS=3

# LLM Provider Configuration
# Supported providers: "openrouter", "openai", or "mock" (100% free offline mode)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nousresearch/hermes-3-llama-3.1-8b
LLM_TEMPERATURE=0.2

# Optional Fallback API Key
OPENAI_API_KEY=

# Human Escalation Settings & Webhook Dispatcher
ADMISSIONS_OFFICE_EMAIL=admissions@novatech.edu
ESCALATIONS_LOG_PATH=./data/escalations.json
ESCALATION_WEBHOOK_URL=

# Optional Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=False
