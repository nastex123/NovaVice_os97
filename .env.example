# Nova Idiomas Colombia - Admissions Assistant RAG & Automation

# Application and Server Configuration
APP_NAME="Nova Idiomas - Intelligent Admissions and Support Assistant"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Vector Database and Hybrid Retrieval
CHROMA_PERSIST_DIR=./backend/data/chroma_db
CHROMA_COLLECTION_NAME=idiomas_knowledge_base
SIMILARITY_THRESHOLD=0.50
TOP_K_RESULTS=3

# LLM Providers and AI Configuration
# Supported options: "openrouter", "openai", "opencode", or "mock" (100% offline grounded)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=nousresearch/hermes-3-llama-3.1-8b
LLM_TEMPERATURE=0.2

# OpenCode Reasoning Daemon (Local)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_ENABLED=True

# Human Counselor Escalation and Webhook Notifications
ADMISSIONS_OFFICE_EMAIL=admisiones@novaidiomas.edu.co
SUPPORT_OFFICE_EMAIL=soporte@novaidiomas.edu.co
ESCALATIONS_LOG_PATH=./backend/data/escalations.json
ESCALATION_WEBHOOK_URL=

# Python Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=False

# Frequent Response Cache Configuration
CACHE_TTL_SECONDS=3600

